# Copy to .env and fill in. Nothing here is required to start AEGIS:
# without keys it runs fully offline (deterministic router + local vision + offline fallbacks).

# Reasoning: Gemini 2.5 Flash (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback provider
OPENROUTER_API_KEY=

# Google Sign-In (OAuth Web client id from Google Cloud Console).
# Add http://127.0.0.1:8000 and http://localhost:8000 as Authorized JavaScript origins.
# Leave empty to use a local profile instead.
GOOGLE_CLIENT_ID=
AUTH_SECRET=change-me-to-a-long-random-string

# Voice
TTS_VOICE=en-US-ChristopherNeural
WHISPER_MODEL_SIZE=base

# Vision smoothing
TRACK_EMA_ALPHA=0.45
TRACK_PERSISTENCE_MS=850
